# Values intentionally empty. Copy to .env.local (git-ignored) and fill in per environment.
# There is NO API key here by design (ADR 0004): the admin acts as the signed-in admin.
ADMIN_ENV=
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
# Appwrite database id the admin search reads (defaults to "main", the id used by appwrite/).
APPWRITE_DATABASE_ID=
# Server-only HMAC key for the pending-MFA cookie (32+ random characters, same on every instance).
# Required in production; not an Appwrite credential. Generate with: openssl rand -hex 32
ADMIN_COOKIE_SECRET=
# Base URL of the core service; the admin search audit (M06 #41) is sent to it with the signed-in
# admin's JWT. Required in staging and production (https): if unset there, search answers 503.
# Local development may leave it empty (searches are then not persisted).
CORE_API_URL=
