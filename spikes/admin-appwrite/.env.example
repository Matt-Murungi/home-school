# Copy to .env.local. Use the Development Appwrite project, never Production.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server API key with scopes: databases.read/write, tables.read/write, columns.read/write, indexes.read/write, rows.read/write
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=admin_spike
# Table for the spike rows; delete it with npm run cleanup
APPWRITE_SESSIONS_TABLE_ID=sessions
