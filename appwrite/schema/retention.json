          "columns": [
            "active_key"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_subject",
          "type": "key",
          "columns": [
            "subject_kind",
            "subject_id"
          ],
          "orders": [
            "ASC",
            "ASC"
