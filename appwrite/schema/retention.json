{
  "domain": "retention",
  "description": "C03 (#141): retention enforcement bookkeeping (DP-5, DP-6). retention_hold blocks purging for a subject or one row (legal hold, safeguarding); deletion_request is the data-subject deletion lifecycle (C05 owns the user-facing flow); retention_run holds the purge job's lease generations and its per-run summaries. Server-only: no client permission, no table-level read. Holds ids, counts and states, never personal data.",
  "tables": [
    {
      "$id": "retention_hold",
      "name": "retention_hold",
      "enabled": true,
      "rowSecurity": true,
      "$permissions": [],
      "columns": [
        {
          "key": "subject_kind",
          "type": "string",
          "format": "enum",
          "elements": [
            "child",
            "parent",
            "teacher",
            "user",
            "case",
            "row"
          ],
          "required": true
        },
        {
          "key": "subject_id",
          "type": "varchar",
          "size": 80,
          "required": true
        },
        {
          "key": "reason",
          "type": "string",
          "format": "enum",
          "elements": [
            "safeguarding",
            "legal_claim",
            "regulator",
            "dispute",
            "other"
          ],
          "required": true
        },
        {
          "key": "reference",
          "type": "varchar",
          "size": 60,
          "required": false
        },
        {
          "key": "placed_by_id",
          "type": "varchar",
          "size": 36,
          "required": true
        },
        {
          "key": "placed_at",
          "type": "datetime",
          "required": true
        },
        {
          "key": "revoked_by_id",
          "type": "varchar",
          "size": 36,
          "required": false
        },
        {
