  "meta": {
    "user_profile": {
      "deletion": "soft",
      "note": "Row $id equals the Appwrite auth user id. Roles live in Appwrite labels (authoritative) and role_assignment (history)."
    },
    "role_assignment": {
      "deletion": "history",
      "note": "Grant history. active_key = '<user_id>:<role>' while active, null once revoked: unique (user, role) among active grants and re-grant after revoke is possible."
    },
    "parent_profile": {
      "deletion": "soft",
      "note": "One per parent user. Consent lives in consent_record (per child), not here."
    },
    "guardian_link": {
      "deletion": "soft",
      "note": "Second guardian (Phase 2). active_key = '<parent_id>:<user_id>' while invited/active."
    },
    "zone": {
      "deletion": "soft",
      "note": "Kampala neighbourhoods. Coordinates are integer micro-degrees (no floats). Zone names are not personal data."
    },
    "home_location": {
      "deletion": "soft",
      "note": "Separate table from child (ADR 0012: audience split). Several per parent; default_key = parent_id on the single default row, null otherwise, so a second default is rejected by the unique index."
    },
    "child": {
      "deletion": "soft",
      "note": "Sensitive. school and class_level are optional (child homeschooled abroad). No photo column (DP-3). areas_of_concern holds struggle tag ids. No unique name+date_of_birth: twins and re-adds are legitimate; duplicates are a core-service warning."
    },
    "consent_record": {
      "deletion": "immutable",
      "note": "Insert-only by permission today: a withdrawal is a new row with decision=withdrawn, and no client write permission exists. The core service's own key can still update/delete (F03 Repository has no per-table guard); a consent/policy repository wrapper exposing only create/list/get (update/delete raise) is a follow-up for M05/M06. Retention (DP-6, SR 5.5): the retention job is the only allowed hard-deleter. A child's consent rows are removed with the child under the retention policy; no other code path hard-deletes them."
    },
    "policy_acceptance": {
      "deletion": "immutable",
      "note": "Insert-only by permission today (teacher safeguarding policy, terms, privacy): unique per user, policy and version, so a double submit is rejected; no client write permission exists. The core service's own key can still update/delete; the consent/policy repository wrapper exposing only create/list/get is a follow-up for M05/M06. Retention (DP-6, SR 5.5): the retention job is the only allowed hard-deleter. Rows go only when the user's retention period ends."
    },
    "teacher_profile": {
      "deletion": "soft",
      "note": "Zones are in teacher_zone. status becomes active only through the core service after all mandatory checks (SR 7.1). Bio is limited by the text column (16,383 chars max).",
      "non_fk": {
        "photo_file_id": "Appwrite Storage file id, not a table row"
      }
    },
    "teacher_zone": {
      "deletion": "join",
      "note": "Pure join row; hard delete allowed (no history needed)."
    },
    "teacher_document": {
      "deletion": "soft",
      "note": "File lives in the private bucket teacher-docs (file permissions set by the core service). by_expiry serves the daily expiry job.",
      "non_fk": {
        "file_id": "Appwrite Storage file id in bucket teacher-docs, not a table row"
      }
    },
    "teacher_approval": {
      "deletion": "soft",
      "note": "One row per teacher, curriculum and level (SR lists level_ids as an array; rows are queryable and indexable for matching)."
    },
    "availability_slot": {
      "deletion": "soft",
      "note": "Weekly pattern. weekday is ISO (1=Monday). Minutes since midnight in Africa/Kampala wall-clock time (no DST), because it is a recurring pattern, not an instant; end > start is checked by the core service. Overlapping slots for the same teacher and weekday are allowed by the schema (no exclusion constraints in Appwrite); the core service validates and merges overlaps when slots are saved."
    },
    "availability_exception": {
      "deletion": "soft",
      "note": "Leave and one-off unavailability, UTC instants."
    }
  },
