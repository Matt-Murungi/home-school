{
  "domain": "safeguarding",
  "description": "Safeguarding cases, their append-only action log and the reporter-visible status (M04, SR 5.4, 7.12, ADR 0012 scope rule). Strictest permissions: empty table permissions and per-row grants to the assigned lead only.",
  "tables": [
    {
      "$id": "safeguarding_case",
      "name": "safeguarding_case",
      "enabled": true,
      "rowSecurity": true,
      "$permissions": [],
      "columns": [
        {
          "key": "raised_by_id",
          "type": "varchar",
          "size": 36,
          "required": true
        },
        {
          "key": "child_id",
          "type": "varchar",
          "size": 36,
          "required": false
        },
        {
          "key": "teacher_id",
          "type": "varchar",
          "size": 36,
          "required": false
        },
        {
          "key": "session_id",
          "type": "varchar",
          "size": 36,
          "required": false
        },
        {
          "key": "category",
          "type": "string",
          "format": "enum",
          "elements": [
            "something_felt_wrong",
            "conduct",
            "welfare",
            "safety",
            "other"
          ],
          "required": true
        },
        {
          "key": "description",
          "type": "varchar",
          "size": 4000,
          "required": true
        },
        {
          "key": "status",
          "type": "string",
          "format": "enum",
          "elements": [
            "open",
            "acknowledged",
            "investigating",
            "escalated",
            "closed"
          ],
          "required": true
        },
        {
          "key": "assigned_to_id",
          "type": "varchar",
          "size": 36,
          "required": false
        },
        {
          "key": "outcome",
          "type": "varchar",
          "size": 2000,
          "required": false
        },
        {
          "key": "raised_at",
          "type": "datetime",
          "required": true
        },
        {
          "key": "acknowledged_at",
          "type": "datetime",
          "required": false
        },
        {
          "key": "closed_at",
          "type": "datetime",
          "required": false
        },
        {
          "key": "deleted_at",
          "type": "datetime",
          "required": false
        }
      ],
      "indexes": [
        {
          "key": "by_raised_by",
          "type": "key",
          "columns": [
            "raised_by_id"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_child",
          "type": "key",
          "columns": [
            "child_id"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_teacher",
          "type": "key",
          "columns": [
            "teacher_id"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_session",
          "type": "key",
          "columns": [
            "session_id"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_assigned_to",
          "type": "key",
          "columns": [
            "assigned_to_id"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_status_raised",
          "type": "key",
          "columns": [
            "status",
            "raised_at"
          ],
          "orders": [
            "ASC",
            "ASC"
          ]
        }
      ]
    },
    {
      "$id": "safeguarding_action",
      "name": "safeguarding_action",
      "enabled": true,
      "rowSecurity": true,
      "$permissions": [],
      "columns": [
        {
          "key": "case_id",
          "type": "varchar",
          "size": 36,
          "required": true
        },
        {
          "key": "action",
          "type": "varchar",
          "size": 100,
          "required": true
        },
        {
          "key": "detail",
          "type": "varchar",
          "size": 2000,
          "required": false
        },
        {
          "key": "by_id",
          "type": "varchar",
          "size": 36,
          "required": true
        },
        {
          "key": "acted_at",
          "type": "datetime",
          "required": true
        }
      ],
      "indexes": [
        {
          "key": "by_case",
          "type": "key",
          "columns": [
            "case_id",
            "acted_at"
          ],
          "orders": [
            "ASC",
            "ASC"
          ]
        },
        {
          "key": "by_actor",
          "type": "key",
          "columns": [
            "by_id"
          ],
          "orders": [
            "ASC"
          ]
        }
      ]
    },
    {
      "$id": "case_status",
      "name": "case_status",
      "enabled": true,
      "rowSecurity": true,
      "$permissions": [],
      "columns": [
        {
          "key": "case_id",
          "type": "varchar",
          "size": 36,
          "required": true
        },
        {
          "key": "reporter_id",
          "type": "varchar",
          "size": 36,
          "required": true
        },
        {
          "key": "status",
          "type": "string",
          "format": "enum",
          "elements": [
            "received",
            "in_review",
            "closed"
          ],
          "required": true
        },
        {
          "key": "raised_at",
          "type": "datetime",
          "required": true
        },
        {
          "key": "updated_at",
          "type": "datetime",
          "required": false
        },
        {
          "key": "closed_at",
          "type": "datetime",
          "required": false
        }
      ],
      "indexes": [
        {
          "key": "unique_case",
          "type": "unique",
          "columns": [
            "case_id"
          ],
          "orders": [
            "ASC"
          ]
        },
        {
          "key": "by_reporter",
          "type": "key",
          "columns": [
            "reporter_id"
          ],
          "orders": [
            "ASC"
          ]
        }
      ]
    }
  ],
  "meta": {
    "safeguarding_case": {
      "deletion": "soft",
      "note": "RESTRICTED (ADR 0012): no table permission at all; the core service writes each row with read(user:<assigned lead>) per case only (no label read on the table: safeguarding scope rule). Reporters never read this row; they read case_status. Writes by the core service only. The involved teacher is never notified automatically (SAF-4)."
    },
    "safeguarding_action": {
      "deletion": "immutable",
      "append_only": true,
      "note": "APPEND-ONLY case log (SAF-5, SR 5.4). Same restricted per-row grants as the case. Insert-only in the core service (AppendOnlyRepository)."
    },
    "case_status": {
      "deletion": "hard",
      "note": "What the reporter may see (ADR 0012): reference, status and dates only, no content. read(user:<reporter>) plus the case's lead. Never soft-deleted (a soft delete would either hide a financial/idempotency record or free its unique value): the lifecycle is the status column; only the retention job hard-deletes it, after the retention period (DP-6, SR 5.5). One row per case (unique case_id); removed with the case under retention."
    }
  },
  "relations": [
    {
      "from": "safeguarding_case.raised_by_id",
      "to": "user_profile"
    },
    {
      "from": "safeguarding_case.child_id",
      "to": "child"
    },
    {
      "from": "safeguarding_case.teacher_id",
      "to": "teacher_profile"
    },
    {
      "from": "safeguarding_case.session_id",
      "to": "session",
      "deferred": "session table arrives with the scheduling ticket (M03)"
    },
    {
      "from": "safeguarding_case.assigned_to_id",
      "to": "user_profile"
    },
    {
      "from": "safeguarding_action.case_id",
      "to": "safeguarding_case"
    },
    {
      "from": "safeguarding_action.by_id",
      "to": "user_profile"
    },
    {
      "from": "case_status.case_id",
      "to": "safeguarding_case"
    },
    {
      "from": "case_status.reporter_id",
      "to": "user_profile"
    }
  ]
}
